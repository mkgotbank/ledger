# Copy this file to  supabase/.env.payments  and fill in your keys, then run setup-payments.sh.
# NEVER commit .env.payments — it is gitignored. Use TEST keys first; only switch to live keys
# after the Stripe test-mode run in PAYMENTS.md passes.
#
# (Placeholders below are intentionally NOT key-shaped so GitHub secret scanning doesn't flag
#  this template. Replace each REPLACE_ME with your real value.)

# Your Stripe SECRET key — starts with "sk_test_" in test mode.
# From: Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=REPLACE_ME

# Your webhook signing secret — starts with "whsec_".
# From: Stripe dashboard → Developers → Webhooks → (your endpoint) → Signing secret
STRIPE_WEBHOOK_SECRET=REPLACE_ME

# Where checkout returns to (your live app URL)
APP_URL=https://mkgotbank.github.io/ledger/
